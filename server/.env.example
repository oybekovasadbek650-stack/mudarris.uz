# Server porti
PORT=8787
# SQLite baza fayli
DB_PATH=data/orinbosar.db
# Tokenlarni imzolash uchun uzun tasodifiy satr (production'da albatta o'zgartiring)
JWT_SECRET=change-me-to-a-long-random-string
# Rahbariyat paneliga kirish
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Frontend manzili (CORS uchun), vergul bilan bir nechta
CORS_ORIGIN=http://localhost:5173
# Telegram bot (@BotFather). Bo'sh bo'lsa bot ishga tushmaydi, qolgan hammasi ishlaydi
BOT_TOKEN=
# Mini App ochiladigan HTTPS manzil (frontend, masalan Vercel)
WEBAPP_URL=
# Ixtiyoriy: BotFather'da Mini App ochilgan bo'lsa, t.me havolasi (startapp parametri ishlashi uchun)
# masalan https://t.me/orinbosar_bot/app
MINIAPP_LINK=
# seed skripti o'qituvchilarga beradigan boshlang'ich parol
SEED_PASSWORD=123456

# Davomat tizimi (Xodim Plus API) — filiallar va xodimlarni olish uchun (faqat o'qish)
# Davomat jamoasidan faqat o'qish huquqli alohida hisob so'rang. Bo'sh bo'lsa integratsiya o'chiq.
DAVOMAT_URL=
DAVOMAT_LOGIN=
DAVOMAT_PASSWORD=
